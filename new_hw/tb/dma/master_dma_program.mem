00000013
00000013
00000013
00000013
00000013
00000013
00000013

// Phase 2: zero words; both done outputs must pulse without memory accesses.
0ff00293 // addi x5, x0, 255
00028078 // DMA0 source = 255
03f00293 // addi x5, x0, 63
00428078 // DMA0 destination = 63
00000293 // addi x5, x0, 0
00828078 // DMA0 size = 0
03f00293 // addi x5, x0, 63
00029078 // DMA1 source = 63
0ff00293 // addi x5, x0, 255
00429078 // DMA1 destination = 255
00000293 // addi x5, x0, 0
00829078 // DMA1 size = 0
00100293 // addi x5, x0, 1
00c28078 // DMA0 START = 1
00c29078 // DMA1 START = 1
